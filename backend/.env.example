# MRS SOLAR - Environment Variables Template
# Copy this file to .env and configure your variables

# ─── 1. SERVER CONFIGURATION ───────────────────────────────────────────────
PORT=5000
JWT_SECRET=mrs_solari_secret_key_13579

# ─── 2. PERSISTENT CLOUD DATABASES (Survives Render Redeploys) ───────────────
# TiDB Cloud MySQL (Primary)
MYSQL_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/mrs_solar?ssl={"rejectUnauthorized":true}

# MongoDB Atlas (Secondary / Fallback)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/mrs-solar?retryWrites=true&w=majority

# ─── 3. PRIVATE OBJECT STORAGE (Choose ONE or use Encrypted Cloud Vault) ─────
# Option A: Cloudflare R2 (S3-Compatible, 10GB free, Zero Egress Fees)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
# S3_BUCKET_NAME=mrs-solar-docs
# S3_REGION=auto

# Option B: Backblaze B2 (S3-Compatible, 10GB free)
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_ACCESS_KEY_ID=<b2_key_id>
# S3_SECRET_ACCESS_KEY=<b2_application_key>
# S3_BUCKET_NAME=mrs-solar-docs
# S3_REGION=us-east-005

# Option C: Cloudinary (25GB free tier)
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>

# Option D: Encrypted Cloud Database Vault (Default — Zero Config required)
# If no S3 or Cloudinary keys are provided, files are automatically encrypted with AES-256-GCM 
# and stored directly in your MongoDB Atlas / TiDB cloud database.
# Documents are NEVER saved to the ephemeral local disk and survive all Render redeployments.
DOCUMENT_ENCRYPTION_KEY=mrs_solar_super_secure_vault_encryption_key_2026

# ─── 4. GMAIL SMTP RECEIPT MAILER ───────────────────────────────────────────
EMAIL_USER=mrsassociates19@gmail.com
EMAIL_PASS=your_app_password

# ─── 5. AUTOMATED MIDNIGHT AUDIT & EXTERNAL CRON ───────────────────────────
# Secret token to protect the /api/cron/midnight-audit endpoint against unauthorized calls
# Used by GitHub Actions workflow and cron-job.org
CRON_SECRET=mrs_solar_midnight_cron_secret_2026
